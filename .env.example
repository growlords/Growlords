# Growlords Agency Production Environment Variables
# Copy to .env.local for local development or configure in your Vercel Project Settings

# -------------------------------------------------------------
# REQUIRED ENVIRONMENT VARIABLES
# -------------------------------------------------------------

# Destination inbox for all contact form enquiries
CONTACT_EMAIL=growlords@gmail.com

# Resend API Key (Get your free key from https://resend.com)
RESEND_API_KEY=your_resend_api_key_here

# -------------------------------------------------------------
# OPTIONAL EMAIL SENDER CONFIGURATION
# -------------------------------------------------------------
# If you have verified your custom domain in Resend (e.g. growlords.com):
# EMAIL_FROM="Growlords <hello@growlords.com>"
# Otherwise, Resend default testing sender is used automatically:
# EMAIL_FROM="Growlords Website <onboarding@resend.dev>"

# -------------------------------------------------------------
# COMMUNICATIONS (PUBLIC)
# -------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=919460740836
NEXT_PUBLIC_CONTACT_EMAIL=growlords@gmail.com
