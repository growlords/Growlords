# Growlords Agency Production Environment Variables
# Copy to .env.local for local development or configure in your deployment dashboard (e.g. Vercel)

# Target inbox for all client enquiries submitted through the website
CONTACT_EMAIL=growlords@gmail.com

# -------------------------------------------------------------
# EMAIL DELIVERY CONFIGURATION (Choose Option A or Option B)
# -------------------------------------------------------------

# OPTION A: Resend (Recommended for Vercel / Serverless - Free 3,000 emails/mo at resend.com)
RESEND_API_KEY=
EMAIL_FROM="Growlords Website <onboarding@resend.dev>"

# OPTION B: SMTP / Gmail (App Password from myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=growlords@gmail.com
SMTP_PASS=

# -------------------------------------------------------------
# WHATSAPP & COMMUNICATIONS
# -------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=919460740836
NEXT_PUBLIC_CONTACT_EMAIL=growlords@gmail.com
